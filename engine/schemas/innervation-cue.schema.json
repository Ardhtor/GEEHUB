{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geehub.local/schemas/innervation-cue.schema.json",
  "title": "Innervation Action Cue",
  "type": "object",
  "required": [
    "cue_id",
    "source_id",
    "bpm",
    "phase",
    "target_response",
    "duration_beats",
    "trigger",
    "action",
    "state_change"
  ],
  "properties": {
    "cue_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "bpm": {
      "type": "number",
      "minimum": 30,
      "maximum": 300
    },
    "phase": {
      "enum": [
        "on_beat",
        "off_beat",
        "break",
        "silence"
      ]
    },
    "target_response": {
      "enum": [
        "pause",
        "step",
        "turn",
        "breath",
        "reach",
        "stillness"
      ]
    },
    "duration_beats": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "state_change": {
      "type": "object",
      "minProperties": 2
    },
    "silence_beats": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
