{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geehub.local/schemas/timeline.schema.json",
  "title": "GEEHUB Continuous Video Timeline",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "timebase",
    "duration_seconds",
    "growth_model",
    "stages",
    "identity_locks",
    "file_data"
  ],
  "properties": {
    "schema": {
      "const": "geehub.video-timeline/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "timebase": {
      "type": "object",
      "required": [
        "fps"
      ],
      "properties": {
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "timecode_format": {
          "type": "string",
          "default": "seconds"
        }
      },
      "additionalProperties": false
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "growth_model": {
      "type": "string",
      "enum": [
        "continuous_morph",
        "continuous_rig",
        "hybrid_cg",
        "generative_assist",
        "none",
        "unknown"
      ]
    },
    "plotlines": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "domestic-intrusion",
          "institutional-containment",
          "triggered-metamorphosis",
          "remake-refinement",
          "escalation-without-closure"
        ]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "identity_locks": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "file_data": {
      "$ref": "#/$defs/fileData"
    },
    "continuity_policy": {
      "type": "object",
      "properties": {
        "continuous_event": {
          "type": "boolean"
        },
        "cuts_allowed": {
          "type": "boolean"
        },
        "hold_final_state": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": [
        "id",
        "start_seconds",
        "end_seconds",
        "label",
        "function"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string"
        },
        "function": {
          "type": "string",
          "enum": [
            "establish",
            "trigger",
            "sustain",
            "register",
            "escalate",
            "hold",
            "continue",
            "transition",
            "other"
          ]
        },
        "required_visible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "movement": {
              "type": "string"
            },
            "framing": {
              "type": "string"
            },
            "continuity": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "growth": {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean"
            },
            "rate": {
              "type": "string"
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "curve": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "environment_response": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sound_cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fileData": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/mediaFile"
        },
        "growth_passes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage_id",
              "files"
            ],
            "properties": {
              "stage_id": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "mediaFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "provider_file_id": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "video_codec": {
          "type": "string"
        },
        "audio_codec": {
          "type": "string"
        },
        "audio_present": {
          "type": "boolean"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "metadata-only",
            "checksum-verified",
            "media-inspected"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_inspected": {
          "type": "boolean"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim",
              "status"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "observed",
                  "creator-stated",
                  "inferred",
                  "unverified"
                ]
              },
              "source_ref": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
