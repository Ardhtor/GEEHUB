{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GEEHUB Recovery Snapshot Manifest",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "created_at", "repository", "source_commit", "scope", "entry_count", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "entry_count": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        },
        "anyOf": [{"required": ["sha256"]}, {"required": ["git_blob_sha1"]}]
      }
    }
  }
}
