{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GEEHUB Creator Record",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "status",
    "verification",
    "sources",
    "first_seen",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "historical",
        "unknown",
        "archived"
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "observed",
        "independently_verified",
        "archived",
        "inferred",
        "unverified"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform"
        ],
        "properties": {
          "platform": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "url",
          "accessed"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "primary",
              "archive",
              "mirror",
              "reference"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationship_to_geehub": {
      "type": "string"
    },
    "first_seen": {
      "type": "string",
      "format": "date"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
